# PayGuard Environment Configuration (SANDBOX / SIMULATED PAYMENT ENVIRONMENT)

# Application
APP_NAME=PayGuard
APP_ENV=SANDBOX
DEBUG=false
LOG_LEVEL=INFO

# Database (PostgreSQL recommended for production/Docker; SQLite fallback for simple local dev)
# PostgreSQL example: postgresql+psycopg2://payguard:payguard_dev@localhost:5432/payguard
DATABASE_URL=sqlite:///./payguard.db
TEST_DATABASE_URL=sqlite:///./payguard_test.db

# Security (NEVER commit real production secrets; synthetic sandbox defaults below)
WEBHOOK_SECRET=whsec_sandbox_change_me_in_local_env
API_AUTH_TOKEN=pg_sandbox_token_change_me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend
VITE_API_BASE_URL=http://localhost:8000

